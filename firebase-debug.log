[debug] [2026-04-02T03:33:24.341Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/shelftalk-acf7e/rulesets {"name":"projects/shelftalk-acf7e/rulesets/3ddfaf0f-fdbf-4f0f-8b84-16132d934b9d","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return signedIn() && request.auth.uid == userId;\r\n    }\r\n\r\n    function canReadPost(postId) {\r\n      let post = get(/databases/$(database)/documents/posts/$(postId));\r\n      return post.data.isPublic == true || (signedIn() && post.data.authorId == request.auth.uid);\r\n    }\r\n\r\n    match /users/{userId} {\r\n      allow read, create, update, delete: if isOwner(userId);\r\n\r\n      match /shelves/{shelfId} {\r\n        allow read, create, update, delete: if isOwner(userId);\r\n\r\n        match /books/{bookId} {\r\n          allow read, create, update, delete: if isOwner(userId);\r\n        }\r\n      }\r\n    }\r\n\r\n    match /books/{bookId} {\r\n      allow read: if signedIn();\r\n      allow create: if signedIn();\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    match /posts/{postId} {\r\n      allow read: if resource.data.isPublic == true || (signedIn() && resource.data.authorId == request.auth.uid);\r\n      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;\r\n      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;\r\n\r\n      match /comments/{commentId} {\r\n        allow read: if canReadPost(postId);\r\n        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;\r\n        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;\r\n      }\r\n\r\n      match /likes/{userId} {\r\n        allow read: if canReadPost(postId);\r\n        allow create, delete: if isOwner(userId);\r\n        allow update: if false;\r\n      }\r\n    }\r\n  }\r\n}","name":"firestore.rules"}]},"createTime":"2026-04-02T03:33:24.953263Z","metadata":{"services":["cloud.firestore"]}}
