rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images are stored at: users/{uid}/profile/{filename}
    match /users/{uid}/profile/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Post images are stored at: users/{uid}/posts/{filename}
    // Write: owner only. Read: public so download URLs and feed/profile images work reliably.
    match /users/{uid}/posts/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if true;
    }

    // Deny all other paths by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
